# Copie para backend/.env (fora do git) e preencha.
# Chave gratuita em https://developer.ticketmaster.com/ (Consumer Key).
TICKETMASTER_API_KEY=
TICKETMASTER_PAIS=BR
# E-mail para recuperação de senha. Sem SMTP, o backend imprime a mensagem no log.
# FRONTEND_URL=http://localhost:5173
# EMAIL_HOST=smtp.exemplo.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# EMAIL_USE_TLS=1
# DEFAULT_FROM_EMAIL=CultHub <noreply@exemplo.com>
# Importar fora do docker (em backend/): set -a && . ./.env && set +a && python manage.py importar_ticketmaster
# Dentro do docker: docker compose exec backend python manage.py importar_ticketmaster
# Geocodificação da origem da rota (Photon); padrão: servidor público.
# PHOTON_URL=https://photon.komoot.io
# Rotas de carro e a pé (OSRM); padrão: routing.openstreetmap.de.
# OSRM_CARRO_URL=https://routing.openstreetmap.de/routed-car
# OSRM_A_PE_URL=https://routing.openstreetmap.de/routed-foot
# Produção (ver "Deploy" no README). Sem DATABASE_URL, o banco é o SQLite local.
# DATABASE_URL=postgresql://usuario:senha@host/banco
# DJANGO_SECRET_KEY=
# DJANGO_DEBUG=0
# DJANGO_ALLOWED_HOSTS=meu-dominio.com
# DJANGO_CSRF_TRUSTED_ORIGINS=https://meu-dominio.com
# DJANGO_NUM_PROXIES=1
# E-mail por API HTTP (hospedagem que bloqueia SMTP):
# EMAIL_BACKEND=anymail.backends.brevo.EmailBackend
# BREVO_API_KEY=
