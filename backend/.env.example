# Copie para backend/.env (fora do git) e preencha.
# Chave gratuita em https://developer.ticketmaster.com/ (Consumer Key).
TICKETMASTER_API_KEY=
TICKETMASTER_PAIS=BR
# Importar fora do docker (em backend/): set -a && . ./.env && set +a && python manage.py importar_ticketmaster
# Dentro do docker: docker compose exec backend python manage.py importar_ticketmaster
# Geocodificação da origem da rota (Photon); padrão: servidor público.
# PHOTON_URL=https://photon.komoot.io
# Rotas de carro e a pé (OSRM); padrão: routing.openstreetmap.de.
# OSRM_CARRO_URL=https://routing.openstreetmap.de/routed-car
# OSRM_A_PE_URL=https://routing.openstreetmap.de/routed-foot
